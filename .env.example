[TEMPLATE]
# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-this-in-production-12345

# Base URL — REQUIRED for production (used in email links)
# Set this to your deployed URL, e.g. https://your-app.up.railway.app
# BASE_URL=https://your-app.up.railway.app

# Database Configuration
DATABASE_URL=mysql+pymysql://root:@localhost/lspu_scholarhub
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lspu_scholarhub

# Email Configuration (for notifications) - OPTIONAL
# Without MAIL_USERNAME/MAIL_PASSWORD the app still runs, but every send is
# wrapped in try/except and silently skipped, so nobody is notified. Gmail needs
# an App Password, not the account password:
# https://support.google.com/accounts/answer/185833
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-16-character-app-password

# Application Configuration
# Where uploaded documents and campus form templates live. This MUST be a
# persistent path in production: Railway's container filesystem is wiped on
# every redeploy, so the default below is for local development only. Either
# mount a volume (e.g. /data) and set UPLOAD_FOLDER=/data/uploads, or set
# CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET to store
# files in Cloudinary instead. Losing this folder 404s every student document.
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB max file size

# JWT Configuration (FREE - just use any random string)
JWT_SECRET_KEY=jwt-secret-key-change-this-in-production-67890
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour

# Chatbot Configuration - FREE VERSION (no API key needed)
# Using pre-determined responses - no external API required
CHATBOT_ENABLED=true
CHATBOT_TYPE=rule_based

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ── LSPU portal integration (read-only student data) ─────────────────────
# ScholarHub never writes to the portal. Leave PORTAL_ENABLED=false until
# ICTS hands over access. See docs/PORTAL_INTEGRATION.md.
PORTAL_ENABLED=false
# sql  = read-only replica / SELECT-only SQL login (target setup)
# file = CSV/JSON export of the same view (interim + local testing)
# PORTAL_SOURCE=sql
# PORTAL_DSN=mysql+pymysql://read_only_user:CHANGE_ME@replica-host:3306/lspu_portal
# PORTAL_STUDENTS_VIEW=portal_students
# PORTAL_ID_COLUMN=student_id
# PORTAL_EXPORT_FILE=portal_students.csv
# Refresh a student at login when their copy is older than this many minutes
PORTAL_FRESHNESS_MINUTES=60
# Required only for the /api/portal/sync webhook (HMAC-SHA256 shared secret)
# PORTAL_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_STRING
