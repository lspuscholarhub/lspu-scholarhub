# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-this-in-production-12345

# Database Configuration
DATABASE_URL=mysql+pymysql://root:@localhost/lspu_scholarhub
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lspu_scholarhub

# Email Configuration (for notifications) - OPTIONAL
# You can use Gmail for free or skip email notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# Application Configuration
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB max file size

# JWT Configuration (FREE - just use any random string)
JWT_SECRET_KEY=jwt-secret-key-change-this-in-production-67890
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour

# Chatbot Configuration - FREE VERSION (no API key needed)
# Using pre-determined responses - no external API required
CHATBOT_ENABLED=true
CHATBOT_TYPE=rule_based

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
